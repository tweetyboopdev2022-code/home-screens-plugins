{
  "id": "dinner-tonight",
  "name": "Dinner Tonight",
  "version": "1.2.0",
  "description": "Tonight's dinner from the Home Screens meal planner, big, with tomorrow underneath.",
  "author": "tweetyboopdev2022-code",
  "license": "MIT",
  "minAppVersion": "1.7.1",
  "moduleType": "dinner-tonight",
  "category": "Personal",
  "icon": "UtensilsCrossed",
  "defaultConfig": {
    "slot": "dinner",
    "accentColor": "#b45309",
    "view": "tonight",
    "days": 7
  },
  "defaultSize": {
    "w": 1000,
    "h": 240
  },
  "defaultStyle": {
    "fontSize": 18,
    "padding": 28,
    "borderRadius": 28
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "view": {
        "type": "string",
        "title": "View",
        "enum": [
          "tonight",
          "week"
        ],
        "enumLabels": [
          "Tonight (big)",
          "This week (row of days)"
        ],
        "ui:widget": "select",
        "ui:group": "Content"
      },
      "slot": {
        "type": "string",
        "title": "Meal",
        "ui:widget": "select",
        "ui:group": "Content",
        "enum": [
          "breakfast",
          "lunch",
          "dinner"
        ],
        "enumLabels": [
          "Breakfast",
          "Lunch",
          "Dinner"
        ]
      },
      "accentColor": {
        "type": "string",
        "title": "Accent colour",
        "ui:widget": "color",
        "ui:group": "Look"
      },
      "days": {
        "type": "number",
        "title": "Days in the week row",
        "minimum": 3,
        "maximum": 7,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Content"
      }
    }
  },
  "exports": {
    "component": "default"
  },
  "dataRequirements": [],
  "prefetchUrl": null,
  "permissions": [
    "storage"
  ]
}